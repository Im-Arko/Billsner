DEBUG=false
SECRET_KEY=generate-a-random-secret
DATABASE_URL=sqlite+aiosqlite:///./data/billanalyser.db
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
BILL_PROCESSING_TIMEOUT_SECONDS=180
DB_OPERATION_TIMEOUT_SECONDS=30
WORKER_POLL_SECONDS=1
UPLOAD_DIR=./uploads
SEARCH_INDEX_PATH=./data/search.db
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Set these to your installed native OCR tools if they are not on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\poppler\Library\bin
